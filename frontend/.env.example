VITE_API_URL=http://localhost:8080

# Production flag shared by third-party integrations; keep false locally.
# Analytics (PostHog) only initializes when this is true and a token is set.
VITE_IS_PRODUCTION=false

# PostHog product analytics
# Project token + host from https://us.posthog.com/settings/project (or EU cloud)
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
